# CORS - comma-separated list of allowed origins (no wildcards in production).
# Production example:
#   STORE_CORS=https://yourdomain.com,https://www.yourdomain.com
#   ADMIN_CORS=https://admin.yourdomain.com
#   AUTH_CORS=https://yourdomain.com,https://www.yourdomain.com,https://admin.yourdomain.com
# Regex patterns are also accepted: /https:\/\/.*\.vercel\.app$/
STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com

# Redis Infrastructure (Event Bus, Workflow Engine, Locking, Caching, Sessions)
# Required in production; falls back to in-memory defaults in local development when unset.
# Supports standard redis:// and TLS rediss:// (Upstash, Redis Cloud, Railway, etc.).
# Examples:
#   Local dev: redis://localhost:6379
#   Managed TLS: rediss://default:password@your-redis-host:6379
REDIS_URL=redis://localhost:6379

# Worker Mode & Multi-Instance Topology
# Options:
#   "shared" (default): single instance running both HTTP API/admin and background subscribers/jobs.
#   "server": runs HTTP API routes and Admin dashboard only (no background event processors or scheduled jobs).
#   "worker": runs background subscriber listeners, BullMQ workflow queues, and scheduled jobs only (no HTTP/Admin).
MEDUSA_WORKER_MODE=shared

# Disable Medusa Admin (recommended for dedicated worker instances)
# Set to true on worker instances where the admin dashboard is not needed.
DISABLE_MEDUSA_ADMIN=false

# Secrets - PRODUCTION: must be at least 32 characters and kept private.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
# JWT lifetime - must match the storefront cookie maxAge (currently 7d = 60*60*24*7 seconds).
# Uses ms-package format: "7d", "24h", "2d", etc. Default when unset: "7d".
JWT_EXPIRES_IN=7d
DATABASE_URL=
DB_NAME=medusa-backend

# Storefront URL - used for generating password reset and verification links
STOREFRONT_URL=http://localhost:8000

# ISR Revalidation Secret - must match storefront REVALIDATE_SECRET
# Must be at least 32 characters in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=replace-with-32-plus-random-chars

# Resend Email Integration (Password Reset & Customer Notifications)
# In development, if RESEND_API_KEY is not set, reset links are logged to console.
RESEND_API_KEY=
RESEND_FROM_EMAIL=LITA <onboarding@resend.dev>

# Cloudflare R2 Storage (Medusa v2 S3 File Module Provider)
# Required in production. In development, if unset, falls back to local disk storage.
# Public URL for uploaded files (no trailing slash). Custom domain in prod, r2.dev in dev.
R2_FILE_URL=
# S3 API endpoint for Cloudflare R2 (MUST NOT include bucket name)
# Format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Bucket name (e.g. lita-media)
R2_BUCKET=
# R2 API token credentials scoped to the bucket with Object Read & Write
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Region (always 'auto' for Cloudflare R2)
R2_REGION=auto

# Razorpay Payment Integration (Medusa v2 Payment Module Provider)
# Obtain test mode API keys from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
# Webhook secret configured in Razorpay Dashboard -> Settings -> Webhooks
# Webhook URL: https://<backend-domain>/hooks/payment/pp_razorpay_razorpay
RAZORPAY_WEBHOOK_SECRET=xxx
# Local-dev escape hatch: set to true to allow startup with dummy Razorpay placeholders
# when live/test keys are not yet configured. Missing Razorpay credentials fail startup by default.
ALLOW_DEV_PAYMENT_PLACEHOLDERS=false

# Cloudflare Turnstile Bot Protection (Inquiry & Newsletter)
# Cloudflare always-passing test key: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Studio Notification Inbox (Receives contact messages, artwork & commission inquiries)
STUDIO_EMAIL=studio@livinintheart.com

# IP Hashing Salt (Privacy-safe hashing of client IPs for rate-limiting and inquiry metadata)
IP_HASH_SALT=replace-with-random-salt-string

# Upstash Redis REST API (Optional distributed rate-limiting across edge/serverless)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

