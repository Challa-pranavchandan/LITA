# Medusa v2 backend
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# Settings > Publishable API Keys in the Medusa admin
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_xxx
# Region used for pricing and checkout (ISO-2 country code, e.g. in)
NEXT_PUBLIC_DEFAULT_REGION=in
NEXT_PUBLIC_DEFAULT_COUNTRY=in

# Shown in header, footer and metadata
NEXT_PUBLIC_SITE_NAME=Livin In The Art
NEXT_PUBLIC_SITE_URL=http://localhost:8000
NEXT_PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_CONTACT_EMAIL=hello@livinintheart.com

# Supabase Authentication & SSR (Optional - if using Supabase Auth as identity provider)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Feature flags
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# Cloudflare R2 Public Hostname for next/image remotePatterns (optional if using R2 for product images)
# Format: hostname without protocol or path (e.g. pub-<hash>.r2.dev or media.yourdomain.com)
R2_PUBLIC_HOSTNAME=
# Secret token for on-demand ISR cache revalidation (POST /api/revalidate)
# Must be at least 32 characters in production. Match between backend and storefront.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=replace-with-32-plus-random-chars

# Cloudflare Turnstile Bot Protection
# Cloudflare always-passing test site key: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Upstash Redis REST API (Required in production for distributed sliding window rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

